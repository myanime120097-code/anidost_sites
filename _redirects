# ============================================
# Ani Dost — Cloudflare Pages Redirects
# ============================================

# Anime type URLs → /anime.html?type=xyz
/anime/series       /anime.html?type=series     200
/anime/movies       /anime.html?type=movies     200
/anime/save         /anime.html?type=save       200
/anime/history      /anime.html?type=history    200
/anime/all          /anime.html                 200

# Genre URLs → /anime.html?genre=xyz
/anime/genre/:genre /anime.html?genre=:genre    200

# Details URLs → /details.html?slug=xyz
/details/:slug      /details.html?slug=:slug    200

# Legacy URLs (পুরনো bookmark তবু কাজ করবে)
/anime              /anime.html                 200
/details            /details.html               200
